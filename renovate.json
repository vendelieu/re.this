{
  "extends": [
    "config:base",
    ":disableDependencyDashboard"
  ],
  "baseBranches": ["dev"],
  "branchConcurrentLimit": 10,
  "prHourlyLimit": 20,
  "automerge": true,
  "automergeType": "branch",
  "automergeStrategy": "squash",
  "timezone": "Europe/Berlin",
  "schedule": ["before 6am on monday"],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["before 6am on monday"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "npm security pins in the version catalog (Renovate's gradle manager can't see npm packages)",
      "fileMatch": ["^gradle/libs\\.versions\\.toml$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s*\\n\\S+\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ]
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "schedule": ["at any time"],
    "automerge": false
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "groupSlug": "github-actions",
      "automerge": true
    },
    {
      "matchPackagePatterns": ["*"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    },
    {
      "matchPackagePatterns": ["*"],
      "matchUpdateTypes": ["major"],
      "automerge": true
    }
  ]
}
